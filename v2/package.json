{
  "name": "giant-appetite",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm --filter @ga/client dev",
    "build": "pnpm -r build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "lint": "eslint .",
    "validate": "pnpm --filter @ga/content validate",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm validate"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
